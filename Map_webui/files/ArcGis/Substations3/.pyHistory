import arcpy import csv import os  # --- USER SETTINGS --- fc = r"C:\Users\Krzysztof\Documents\ArcGIS\Projects\Substations3\Substations3.gdb\Substation_Census_2_Dissolve"   # your polygon layer csv_path = r"C:\Users\Krzysztof\Desktop\outage_status.csv"                 # your outage csv  subs_field = "Concatenated_Title"   # field with names like A|B|C pop_field = "SHAPE_population"               # population field  csv_name_field = "Name"             # substation name column in CSV csv_out_field = "Outage"            # outage status column in CSV (1/0)  outaged_list_field = "OutagedSubs" n_total_field = "N_total" n_out_field = "N_out" status_field = "ServeStat" served_pop_field = "ServedPop" reduced_pop_field = "ReducedPop" outaged_pop_field = "OutagedPop"  delimiter = "|" # ---------------------  # Load CSV into a dictionary outage_dict = {} with open(csv_path, "r", newline="", encoding="utf-8-sig") as f:     reader = csv.DictReader(f)     for row in reader:         name = row[csv_name_field].strip()         try:             outage = int(row[csv_out_field])         except:             outage = 0         outage_dict[name] = outage  # Update each feature fields = [     subs_field, pop_field,     outaged_list_field, n_total_field, n_out_field,     status_field, served_pop_field, reduced_pop_field, outaged_pop_field ]  fully_served_total = 0.0 reduced_total = 0.0 fully_outaged_total = 0.0  with arcpy.da.UpdateCursor(fc, fields) as cur:     for row in cur:         subs_raw = row[0] or ""         pop = float(row[1] or 0)          subs = [s.strip() for s in subs_raw.split(delimiter) if s.strip()]         n_total = len(subs)          outaged_subs = [s for s in subs if outage_dict.get(s, 0) == 1]         n_out = len(outaged_subs)          outaged_list = delimiter.join(outaged_subs)          if n_total == 0:             status = "NO_SUBSTATION"             served_pop = 0             reduced_pop = 0             outaged_pop = pop         elif n_out == 0:             status = "FULL"             served_pop = pop             reduced_pop = 0             outaged_pop = 0             fully_served_total += pop         elif n_out < n_total:             status = "REDUCED"             served_pop = 0             reduced_pop = pop             outaged_pop = 0             reduced_total += pop         else:             status = "OUTAGE"             served_pop = 0             reduced_pop = 0             outaged_pop = pop             fully_outaged_total += pop          row[2] = outaged_list         row[3] = n_total         row[4] = n_out         row[5] = status         row[6] = served_pop         row[7] = reduced_pop         row[8] = outaged_pop          cur.updateRow(row)  print("Done.") print(f"Fully served population: {fully_served_total:,.2f}") print(f"Reduced-service population: {reduced_total:,.2f}") print(f"Fully outaged population: {fully_outaged_total:,.2f}")
import arcpy import csv import os  # --- USER SETTINGS --- fc = r"C:\Users\Krzysztof\Documents\ArcGIS\Projects\Substations3\Substations3.gdb\Substation_Census_2_Dissolve"   # your polygon layer csv_path = r"C:\Users\Krzysztof\Desktop\outage_status.csv"                 # your outage csv  subs_field = "Concatenated_Title"   # field with names like A|B|C pop_field = "SHAPE_population"               # population field  csv_name_field = "Name"             # substation name column in CSV csv_out_field = "Outage"            # outage status column in CSV (1/0)  outaged_list_field = "OutagedSubs" n_total_field = "N_total" n_out_field = "N_out" status_field = "ServeStat" served_pop_field = "ServedPop" reduced_pop_field = "ReducedPop" outaged_pop_field = "OutagedPop"  delimiter = "|" # ---------------------  # Load CSV into a dictionary outage_dict = {} with open(csv_path, "r", newline="", encoding="utf-8-sig") as f:     reader = csv.DictReader(f)     for row in reader:         name = row[csv_name_field].strip()         try:             outage = int(row[csv_out_field])         except:             outage = 0         outage_dict[name] = outage  # Update each feature fields = [     subs_field, pop_field,     outaged_list_field, n_total_field, n_out_field,     status_field, served_pop_field, reduced_pop_field, outaged_pop_field ]  fully_served_total = 0.0 reduced_total = 0.0 fully_outaged_total = 0.0  with arcpy.da.UpdateCursor(fc, fields) as cur:     for row in cur:         subs_raw = row[0] or ""         pop = float(row[1] or 0)          subs = [s.strip() for s in subs_raw.split(delimiter) if s.strip()]         n_total = len(subs)          outaged_subs = [s for s in subs if outage_dict.get(s, 0) == 1]         n_out = len(outaged_subs)          outaged_list = delimiter.join(outaged_subs)          if n_total == 0:             status = "NO_SUBSTATION"             served_pop = 0             reduced_pop = 0             outaged_pop = pop         elif n_out == 0:             status = "FULL"             served_pop = pop             reduced_pop = 0             outaged_pop = 0             fully_served_total += pop         elif n_out < n_total:             status = "REDUCED"             served_pop = 0             reduced_pop = pop             outaged_pop = 0             reduced_total += pop         else:             status = "OUTAGE"             served_pop = 0             reduced_pop = 0             outaged_pop = pop             fully_outaged_total += pop          row[2] = outaged_list         row[3] = n_total         row[4] = n_out         row[5] = status         row[6] = served_pop         row[7] = reduced_pop         row[8] = outaged_pop          cur.updateRow(row)  print("Done.") print(f"Fully served population: {fully_served_total:,.2f}") print(f"Reduced-service population: {reduced_total:,.2f}") print(f"Fully outaged population: {fully_outaged_total:,.2f}")
import arcpy import csv  fc = r"C:\Users\Krzysztof\Documents\ArcGIS\Projects\Substations3\Substations3.gdb\Substation_Census_2_Dissolve" csv_path = r"C:\Users\Krzysztof\Desktop\Outage_status.csv"  subs_field = "Concatenated_Title"     # field like A|B|C pop_field = "SHAPE_population"        # change if needed  csv_name_field = "Name" csv_out_field = "Outage"  outaged_list_field = "OutagedSubs" n_total_field = "N_total" n_out_field = "N_out" status_field = "ServeStat" served_pop_field = "ServedPop" reduced_pop_field = "ReducedPop" outaged_pop_field = "OutagedPop"  delimiter = "|"  # -------------------------------------------------- # Load outage CSV # Keep only valid 0/1 values # Missing / blank values are ignored # -------------------------------------------------- outage_dict = {}  with open(csv_path, "r", newline="", encoding="utf-8-sig") as f:     reader = csv.DictReader(f)     for row in reader:         name = (row.get(csv_name_field) or "").strip()         raw_out = (row.get(csv_out_field) or "").strip()          if not name:             continue          if raw_out in ("0", "1"):             outage_dict[name] = int(raw_out)         else:             # blank / null / invalid outage values are ignored             pass  fields = [     subs_field, pop_field,     outaged_list_field, n_total_field, n_out_field,     status_field, served_pop_field, reduced_pop_field, outaged_pop_field ]  fully_served_total = 0.0 reduced_total = 0.0 fully_outaged_total = 0.0 no_data_total = 0.0  with arcpy.da.UpdateCursor(fc, fields) as cur:     for row in cur:         subs_raw = row[0] or ""         pop = float(row[1] or 0)          # all substations listed in polygon         subs_all = [s.strip() for s in subs_raw.split(delimiter) if s.strip()]          # only substations that actually exist in CSV with valid 0/1 value         subs_known = [s for s in subs_all if s in outage_dict]          n_total = len(subs_known)          outaged_subs = [s for s in subs_known if outage_dict[s] == 1]         n_out = len(outaged_subs)          outaged_list = delimiter.join(outaged_subs)          if n_total == 0:             # none of the listed substations had usable outage info             status = "NO_DATA"             served_pop = 0             reduced_pop = 0             outaged_pop = 0             no_data_total += pop          elif n_out == 0:             status = "FULL"             served_pop = pop             reduced_pop = 0             outaged_pop = 0             fully_served_total += pop          elif n_out < n_total:             status = "REDUCED"             served_pop = 0             reduced_pop = pop             outaged_pop = 0             reduced_total += pop          else:             status = "OUTAGE"             served_pop = 0             reduced_pop = 0             outaged_pop = pop             fully_outaged_total += pop          row[2] = outaged_list[:1000]   # protect against field length overflow         row[3] = n_total         row[4] = n_out         row[5] = status         row[6] = served_pop         row[7] = reduced_pop         row[8] = outaged_pop          cur.updateRow(row)  print("Done.") print(f"Fully served population: {fully_served_total:,.2f}") print(f"Reduced-service population: {reduced_total:,.2f}") print(f"Fully outaged population: {fully_outaged_total:,.2f}") print(f"No-data population: {no_data_total:,.2f}")
import arcpy import csv  fc = r"C:\Users\Krzysztof\Documents\ArcGIS\Projects\Substations3\Substations3.gdb\Substation_Census_2_Dissolve" csv_path = r"C:\Users\Krzysztof\Desktop\Outage_status.csv"  subs_field = "Concatenated_Title" pop_field = "SHAPE_population"   # change if needed  csv_name_field = "Name" csv_out_field = "Outage"  # load CSV outage_dict = {} with open(csv_path, "r", newline="", encoding="utf-8-sig") as f:     reader = csv.DictReader(f)     for row in reader:         name = (row.get(csv_name_field) or "").strip()         raw_out = (row.get(csv_out_field) or "").strip()         if name and raw_out in ("0", "1"):             outage_dict[name] = int(raw_out)  oid_to_check = 79 delimiter = "|"  fields = ["OBJECTID", subs_field, pop_field, "ServeStat", "OutagedSubs", "N_total", "N_out"]  with arcpy.da.SearchCursor(fc, fields) as cur:     for row in cur:         if row[0] == oid_to_check:             print("OBJECTID:", row[0])             print("Concatenated_Title:", row[1])             print("Population:", row[2])             print("Existing ServeStat:", row[3])             print("Existing OutagedSubs:", row[4])             print("Existing N_total:", row[5])             print("Existing N_out:", row[6])              subs_all = [s.strip() for s in (row[1] or "").split(delimiter) if s.strip()]             subs_known = [s for s in subs_all if s in outage_dict]             subs_unknown = [s for s in subs_all if s not in outage_dict]             outaged_subs = [s for s in subs_known if outage_dict[s] == 1]              print("\nParsed substations:")             for s in subs_all:                 print("  ", repr(s))              print("\nKnown in CSV:")             for s in subs_known:                 print("  ", repr(s), "->", outage_dict[s])              print("\nMissing from CSV:")             for s in subs_unknown:                 print("  ", repr(s))              print("\nComputed:")             print("N_total =", len(subs_known))             print("N_out =", len(outaged_subs))             if len(subs_known) == 0:                 print("Expected ServeStat = NO_DATA")             elif len(outaged_subs) == 0:                 print("Expected ServeStat = FULL")             elif len(outaged_subs) < len(subs_known):                 print("Expected ServeStat = REDUCED")             else:                 print("Expected ServeStat = OUTAGE")
import arcpy import csv  fc = r"C:\Users\Krzysztof\Documents\ArcGIS\Projects\Substations3\Substations3.gdb\Substation_Census_2_Dissolve" csv_path = r"C:\Users\Krzysztof\Desktop\Outage_status.csv"  subs_field = "Concatenated_Title" pop_field = "SHAPE_population"   # change if needed  csv_name_field = "Name" csv_out_field = "Outage"  delimiter = "|"  # load CSV outage_dict = {} with open(csv_path, "r", newline="", encoding="utf-8-sig") as f:     reader = csv.DictReader(f)     for row in reader:         name = (row.get(csv_name_field) or "").strip()         raw_out = (row.get(csv_out_field) or "").strip()         if name and raw_out in ("0", "1"):             outage_dict[name] = int(raw_out)  oid_to_update = 79  fields = [     "OBJECTID", subs_field, pop_field,     "OutagedSubs", "N_total", "N_out",     "ServeStat", "ServedPop", "ReducedPop", "OutagedPop" ]  with arcpy.da.UpdateCursor(fc, fields) as cur:     for row in cur:         if row[0] == oid_to_update:             subs_all = [s.strip() for s in (row[1] or "").split(delimiter) if s.strip()]             subs_known = [s for s in subs_all if s in outage_dict]             outaged_subs = [s for s in subs_known if outage_dict[s] == 1]              n_total = len(subs_known)             n_out = len(outaged_subs)             pop = float(row[2] or 0)              if n_total == 0:                 status = "NO_DATA"                 served_pop = 0                 reduced_pop = 0                 outaged_pop = 0             elif n_out == 0:                 status = "FULL"                 served_pop = pop                 reduced_pop = 0                 outaged_pop = 0             elif n_out < n_total:                 status = "REDUCED"                 served_pop = 0                 reduced_pop = pop                 outaged_pop = 0             else:                 status = "OUTAGE"                 served_pop = 0                 reduced_pop = 0                 outaged_pop = pop              row[3] = "|".join(outaged_subs)             row[4] = n_total             row[5] = n_out             row[6] = status             row[7] = served_pop             row[8] = reduced_pop             row[9] = outaged_pop              cur.updateRow(row)             print("Updated OBJECTID 79 successfully.")             print("Status:", status)             print("N_total:", n_total)             print("N_out:", n_out)             print("OutagedSubs:", "|".join(outaged_subs))             break
import arcpy  fc = r"C:\Users\Krzysztof\Documents\ArcGIS\Projects\Substations3\Substations3.gdb\Substation_Census_2_Dissolve"  fields = ["ServeStat", "N_total", "N_out", "ServedPop", "ReducedPop", "OutagedPop"]  null_counts = {f: 0 for f in fields} total_rows = 0  with arcpy.da.SearchCursor(fc, fields) as cur:     for row in cur:         total_rows += 1         for i, f in enumerate(fields):             if row[i] is None:                 null_counts[f] += 1  print(f"Total rows: {total_rows}") for f in fields:     print(f"{f}: {null_counts[f]} nulls")
